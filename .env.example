# Watch Collection Tracker - Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=watch_tracker
POSTGRES_USER=watchuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================
# Security Configuration
# ============================================
# Generate a strong secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS Configuration
# ============================================
# Production: Use your domain
# ALLOWED_ORIGINS=https://yourdomain.com
# Development: Use localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ============================================
# Application Configuration
# ============================================
# HTTP port for Nginx
HTTP_PORT=8080

# HTTPS port for Nginx (uncomment for production with SSL)
# HTTPS_PORT=443

# Maximum file upload size in bytes (20MB default)
MAX_UPLOAD_SIZE=20971520
# Service documents (bytes, 10MB default) and per-record caps
# MAX_DOCUMENT_SIZE=10485760
# MAX_IMAGES_PER_WATCH=50
# MAX_DOCUMENTS_PER_SERVICE=20

# ============================================
# Accounts
# ============================================
# Public sign-up is off by default. Set to true to let anyone register.
ALLOW_REGISTRATION=false
# On an empty database, this email may register and becomes the admin.
INITIAL_ADMIN_EMAIL=
# Refresh-token cookie Secure flag: leave unset to follow the request scheme
# (set true when TLS ends at a proxy that does not send X-Forwarded-Proto)
# COOKIE_SECURE=true
# Lock an account for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_FAILURES wrong passwords
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# ============================================
# Frontend Configuration
# ============================================
# API URL for frontend (use relative path for same domain)
VITE_API_URL=/api

# ============================================
# Monitoring (Future)
# ============================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://your_sentry_dsn
