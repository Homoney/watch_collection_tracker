# Settings for docker-compose.yml. All are optional.
# Copy to .env and edit what you need.

# Email of the first admin. Register with it on an empty database and that
# account becomes the admin.
INITIAL_ADMIN_EMAIL=

# Let anyone with the address create an account (default: false)
ALLOW_REGISTRATION=false

# Host port for the web app (http://localhost:8080)
HTTP_PORT=8080

# Image tag to run (default: latest)
# VERSION=2.0.0

# Time zone for log times
TZ=UTC

# --- Advanced ---------------------------------------------------------------
# Default: generated once into /data/secret_key and kept. If you set it, use
# 32+ random characters (openssl rand -hex 32) and never change it.
# SECRET_KEY=

# Behind a reverse proxy: its address (or range), so rate limits and secure
# cookies see the real client. Default: 127.0.0.1
# TRUSTED_PROXIES=

# Days to keep the daily database backups (default 30)
# BACKUP_KEEP_DAYS=30

# Lifetime of signed links to uploaded files, in seconds (default 3600)
# UPLOAD_URL_TTL_SECONDS=3600

# Upload size limits in bytes (defaults: 20 MB images, 10 MB documents)
# MAX_UPLOAD_SIZE=20971520
# MAX_DOCUMENT_SIZE=10485760

# Account lockout after wrong passwords (defaults: 5 tries, 15 minutes)
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
